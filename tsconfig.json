{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "dom",
      "es2022"
    ],
    "types": [
      "cypress",
      "node",
      "vite/client"
    ],
    "allowJs": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": "./src",
    "declaration": false,
    "module": "esNext",
    "moduleResolution": "bundler",
    "sourceMap": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "**/*.spec.ts",
    "node_modules",
    "vendor",
    "public"
  ],
  "compileOnSave": false
}
